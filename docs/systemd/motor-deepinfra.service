[Unit]
Description=Yachay — adaptador aislado de propuestas DeepInfra
Documentation=file:///home/panda/Yachay/docs/systemd/README.md
Requires=yachay-deepinfra-firewall.service
After=network-online.target yachay-deepinfra-firewall.service
Wants=network-online.target

[Service]
Type=exec
User=yachay-net
Group=panda
WorkingDirectory=/
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/panda/Yachay/src
Environment=YACHAY_DEEPINFRA_SOCKET=/run/yachay-deepinfra/deepinfra.sock
Environment=YACHAY_DEEPINFRA_IPS_FILE=/run/yachay-deepinfra-firewall/provider-ips.json
LoadCredential=deepinfra_api_key:/home/panda/.config/yachay/deepinfra-api-key
RuntimeDirectory=yachay-deepinfra
RuntimeDirectoryMode=0750
ExecStart=/home/panda/Yachay/.venv/bin/python -m motor deepinfra

Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=20

# Único proceso con salida de red. No escucha por TCP; solo AF_UNIX.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/panda/Yachay/src /home/panda/Yachay/.venv
ReadOnlyPaths=/run/yachay-deepinfra-firewall
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
SystemCallArchitectures=native
ReadWritePaths=/run/yachay-deepinfra
UMask=0007

MemoryMax=512M
CPUQuota=50%
TasksMax=32

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

[Unit]
Description=Yachay — API v1 sobre socket Unix
Documentation=file:///home/panda/Yachay/docs/systemd/README.md
# La API es un cliente de solo lectura más tres mutaciones acotadas (ADR-016).
# Puede arrancar con o sin el worker: solo depende de la base de estado.
After=default.target

[Service]
Type=exec
WorkingDirectory=%h/Yachay
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=%h/Yachay/src
# Directorio de runtime gestionado por systemd: el socket vive aquí y systemd
# limpia el directorio al parar la unidad.
RuntimeDirectory=motor
RuntimeDirectoryMode=0750
ExecStart=%h/Yachay/.venv/bin/python -m motor api --root %h/Yachay --socket %t/motor/motor.sock

Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=15

# Endurecimiento (§13). La API NO necesita red: solo el socket Unix.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
SystemCallArchitectures=native

# La API lee el estado y escribe inputs en la bandeja: mismo árbol que el worker.
ReadWritePaths=%h/Yachay/data
UMask=0027

MemoryMax=2G
CPUQuota=100%
TasksMax=128

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
